# 复制此文件为 .env.local 并填入你自己的 Supabase 项目信息
# Supabase 控制台 -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 可选：自有/商业地图瓦片模板，留空使用 OpenStreetMap 公共瓦片
VITE_MAP_TILE_URL=

# 可选：高德 Web 服务 Key，用于中国大陆区域 POI 搜索
# Key 会随前端产物公开，请限制配额并定期轮换
VITE_AMAP_KEY=
